[cltl.object_recognition.events]
image_topic: image_in
object_topic: object_recognition

[cltl.object_recognition.ollama]
model: qwen2.5vl
# host: https://ollama.com
# api_key is read from the OLLAMA_API_KEY environment variable if not set here

[cltl.event.kombu]
server: amqp://localhost:5672
exchange: cltl.combot
type: direct
compression: bzip2
